# Public iPhone app configuration only. Copy to .env.local, then run:
# python3 native/scripts/configure-public.py
# python3 native/scripts/generate-project.py
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY

# DeepSeek keys and Supabase service-role keys belong only on the backend.
# See supabase/README.md. Never put private credentials in the app config.
