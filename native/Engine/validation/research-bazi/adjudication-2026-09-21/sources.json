    "quotes": [
      {
        "text": "寅月 立春后戊土七日，丙火七日，甲木十六日",
        "line": 70
      },
      {
        "text": "申月 立秋后戊己土十日，壬水三日，庚金十七日",
        "line": 72
      },
      {
        "text": "按此表人元司令日数，虽未可执着",
        "line": 72
      },
      {
        "text": "地支所藏之干，本静以待用，透出干头，则显其用矣",
        "line": 72
      },
      {
        "text": "癸水本为所藏，而透壬水则墓本从五行论，不分阴阳也",
        "line": 72
      }
