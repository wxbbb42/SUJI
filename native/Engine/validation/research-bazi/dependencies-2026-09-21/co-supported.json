        "sources": [
          {
            "id": "ziping-helper-constraints-v1",
            "document": "docs/mingli/source-texts/bazi/ziping-zhenquan/00-abstract-chapters.md",
            "sha256": "5b930c11310899b50703696870d9024ba4e00fca6ad177e57d6fa5e3f8a4964f",
            "locator": "十五、论相神紧要；十二、论格局高低",
            "quote": "甲用酉官，透丁逢癸印，制伤以护官矣，而又逢戊，癸合戊而不制丁，癸水之相伤矣",
            "additionalQuotes": [
              "乙用酉煞，年丁月癸，时上逢戊，则合去癸印以使丁得制煞者，全赖戊之相",
              "丁用酉财，透癸逢己，食制煞以生财矣，而又透甲，己合甲而不制癸",
              "若丁火通根，则合之不去",
              "壬水通根申亥为有力",
              "庚用午官，而子冲隔丑，则子丑合而解冲",
              "见寅卯，则水生木，木生午火以解冲，则寅卯为相也"
            ],
            "editionStatus": "electronic-transcription-not-print-collated"
          },
          {
            "id": "ziping-position-season-v1",
            "document": "docs/mingli/source-texts/bazi/ziping-zhenquan/01-foundations.md",
            "sha256": "8ea626e3744bb7129351b57dd3c4d6b6be595484345d8ea8101df50611993596",
            "locator": "论十干合而不合；论十干得时不旺失时不弱",
            "quote": "或虽遥隔而仍作合论，各视其格局配合而已",
            "additionalQuotes": [
              "序有先后，不作妒合争合论也",
              "虽不当令，其用固未尝消失也"
            ],
            "editionStatus": "electronic-transcription-not-print-collated"
          }
        ],
        "limitations": [
          "相神表是当前格局默认候选集合，不穷尽全局取相；藏干候选不等同透干，藏干救应效力未裁定",
          "克、合、根与月令分别记录；相隔、同名多配对或季候标签均不能单独裁定救应有效或失效",
          "地支六合/通关仅列条件，不取消月冲，不以半合充完整三合或已成化；全局力量及合解仍待审",
          "chengBai与jibie保留既有工程候选口径，不代表本条件评估已裁定成败或等级"
        ]
      },
